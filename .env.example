# Host port exposed by Docker Compose.
INKOS_PORT=3000

# Server-only Baidu Static Map API key. Never commit the real value.
INKOS_BAIDU_MAP_AK=

# Keep one container replica. These values control work inside that process.
INKOS_GENERATOR_CONCURRENCY=2
INKOS_SOURCE_CACHE_TTL_MS=180000

# Override this only when testing another registry or a locally tagged image.
INKOS_SERVER_IMAGE=ghcr.io/zhuzhe1983/inkos-server:latest
