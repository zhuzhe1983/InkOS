  "version": 1,
  "feed": {
    "kind": "list",
    "layout": "feed",
    "description": "channel",
    "summary": "teaser-then-body-lede",
    "author": "eyebrow",
    "publishedAt": "calendar-date",
    "image": "media-then-body",
